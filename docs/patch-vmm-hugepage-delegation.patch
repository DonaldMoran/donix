+    /*
+     * Delegate to vmm_get_phys_from_cr3 against the current CR3.
+     *
+     * This function used to carry its own copy of the walk, driven
+     * by get_pml4_virt().  It did not handle 2 MB huge pages -- and
+     * neither did its sibling in intent until vmm_get_phys_from_cr3
+     * grew the PS-bit case.  Two walks, one of which understood
+     * huge pages: any caller that happened to walk a virtual
+     * address covered by a 2 MB page got a garbage physical address
+     * back, because the PDE was dereferenced as a page-table
+     * pointer.
+     *
+     * That latent bug is why this is now a delegation, not a second
+     * implementation.  One walk, with the huge-page case, used by
+     * every caller.  For a kernel address the current CR3 and the
+     * bootinfo PML4 see the same higher-half mappings, so existing
+     * callers (heap.c's prior-page probe, process.c's kernel-stack
+     * phys) get the same answer they did before.  For a user
+     * address, the current CR3 is the one that has the mapping.
+     *
+     * Both existing callers run after vmm_init, so CR3 is a valid
+     * kernel page-table root when this is called.  If a caller ever
+     * needs this before paging is enabled, it must not use this
+     * function -- use the raw phys_to_virt walk directly.
+     */
+    uint64_t cr3;
+    __asm__ volatile("mov %%cr3, %0" : "=r"(cr3));
+    return vmm_get_phys_from_cr3(cr3, virt);
