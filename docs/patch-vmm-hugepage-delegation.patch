+    /*
+     * Delegate to vmm_get_phys_from_cr3 with the current CR3.
+     *
+     * This function used to carry its own walk, without the
+     * huge-page case.  For an address covered by a 2 MB huge PDE,
+     * the old walk dereferenced the huge page's physical base as a
+     * page-table pointer and read a garbage PTE.  The wrong answer
+     * -- most likely 0, "not mapped" -- is worse than a wrong
+     * return value: ensure_hhdm_mapped uses the result to decide
+     * whether to call vmm_map_page, and a false "not mapped" turns
+     * into an unnecessary map that used to corrupt memory.
+     *
+     * vmm_get_phys_from_cr3 returns 0 for not-present and a
+     * (physical | offset) for present; a nonzero result means the
+     * page is mapped, huge or not.
+     */
+    uint64_t cr3;
+    __asm__ volatile("mov %%cr3, %0" : "=r"(cr3));
+    return vmm_get_phys_from_cr3(cr3, virt) != 0;
