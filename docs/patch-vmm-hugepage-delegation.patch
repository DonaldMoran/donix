 void vmm_dump_page_table(uint64_t virt) {
@@ -279,6 +247,17 @@ void vmm_dump_page_table(uint64_t virt) {
     if (!(pdpt[pdpt_idx] & PT_PRESENT)) { serial_unlock(); return; }
     uint64_t* pd = phys_to_virt(pte_phys(pdpt[pdpt_idx]));
     if (!(pd[pd_idx] & PT_PRESENT)) { serial_unlock(); return; }
+
+    /* 2 MB huge page: do not dereference the huge base as a
+       page-table pointer.  Print the PDE and stop. */
+    if (pd[pd_idx] & 0x80) {
+        serial_print("  2 MB huge PDE: 0x");
+        serial_print_hex(pd[pd_idx]);
+        serial_print("\n");
+        serial_unlock();
+        return;
+    }
+
     uint64_t* pt = phys_to_virt(pte_phys(pd[pd_idx]));
 
     serial_print("  PTE Entry Found: 0x");
@@ -637,6 +616,54 @@ void vmm_unmap_page_in_cr3(uint64_t cr3, uint64_t virt) {
     uint64_t* pd = (uint64_t*)phys_to_virt(pte_phys(pdpt[pdpt_idx]));
 
     if (!(pd[pd_idx] & PT_PRESENT)) return;
+
+    /* If the PDE is a 2 MB huge page (PS bit set), split it into
+       512 4 KB PTEs before unmapping one page -- the same pattern
+       as vmm_map_page_in_cr3's split.  Without it, the walk below
+       would treat the huge page's physical base as a page-table
+       pointer and write the zero into memory that is not a page
+       table.
+
+       The unmapping is for ONE 4 KB page.  After the split, the
+       other 511 pages of the former huge page are still mapped and
+       their PTEs are unchanged from the split.  That matches what
+       a partial unmap of a huge mapping should do. */
+    if (pd[pd_idx] & 0x80) {
+        uint64_t huge_phys  = pd[pd_idx] & ~0x1FFFFFULL & ~PT_NX;
+        uint64_t huge_flags = pd[pd_idx] & 0xFFF;
+
+        uint64_t new_pt_phys = pmm_alloc_page_for_tables();
+        if (!new_pt_phys) {
+            /* Cannot split.  Refuse to unmap rather than corrupt:
+               halting is loud and safe; the alternative is a write
+               to arbitrary physical memory. */
+            serial_print("VMM: FATAL unmap-page-table alloc failed\n");
+            serial_print("VMM:   virt=0x"); serial_print_hex(virt);
+            serial_print(" cr3=0x");        serial_print_hex(cr3);
+            serial_print(" pde=0x");        serial_print_hex(pd[pd_idx]);
+            serial_print("\n");
+            serial_print("VMM:   halting; unmap was NOT performed\n");
+            while (1) __asm__ volatile("hlt");
+        }
+        uint64_t* split_pt = (uint64_t*)phys_to_virt(new_pt_phys);
+
+        uint64_t carry = huge_flags & (PT_PRESENT | PT_WRITE | PT_USER);
+        uint64_t pte_carry = carry | PT_NX;
+        for (int m = 0; m < 512; m++) {
+            split_pt[m] = (huge_phys + (uint64_t)m * 0x1000) | pte_carry;
+        }
+        pd[pd_idx] = new_pt_phys | carry;
+
+        uint64_t active_cr3_split;
+        asm volatile("mov %%cr3, %0" : "=r"(active_cr3_split));
+        if ((active_cr3_split & ~0xFFFULL) == (cr3 & ~0xFFFULL)) {
+            uint64_t base = virt & ~0x1FFFFFULL;
+            for (uint64_t a = base; a < base + 0x200000; a += 0x1000) {
+                asm volatile("invlpg (%0)" : : "r"(a) : "memory");
+            }
+        }
+    }
+
     uint64_t* pt = (uint64_t*)phys_to_virt(pte_phys(pd[pd_idx]));
 
     pt[pt_idx] = 0;
